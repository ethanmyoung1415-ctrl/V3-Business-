# Synthetic testing image only. Not a production web service.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    V3_LOCAL_DEV=1

WORKDIR /v3
COPY requirements-portal.txt ./requirements-portal.txt
RUN python -m pip install --no-cache-dir -r requirements-portal.txt

COPY . /v3
RUN groupadd --gid 10001 v3local && \
    useradd --uid 10001 --gid 10001 --create-home v3local && \
    chown -R v3local:v3local /v3
USER 10001:10001

# No EXPOSE, no server process, no runtime secrets, no external API calls.
CMD ["python","manage.py","test","catalog_portal","--verbosity","1"]
